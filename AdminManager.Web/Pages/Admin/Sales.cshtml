@page
@model AdminManager.Web.Pages.Admin.SalesModel
@{
    Layout = "_AdminLayout";
}

<h2>Ventas</h2>
<p>Total: @Model.TotalSales</p>

<a asp-page-handler="DownloadAll" class="btn btn-success mb-3">
    Descargar todas en un PDF
</a>

<table class="table table-striped">
    <thead class="table-dark">
        <tr>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Productos</th>
            <th>Total</th>
            <th>Acciones</th> <!-- NUEVA COLUMNA -->
        </tr>
    </thead>
    <tbody>
        @foreach (var sale in Model.Sales)
        {
            <tr>
                <td>@sale.Date.ToShortDateString()</td>
                <td>@sale.ClientName</td>
                <td>@sale.ProductCount</td>
                <td>$@sale.Total</td>
                <td>
                    <form asp-page-handler="Delete"
                          asp-route-id="@sale.Id"
                          method="post"
                          onsubmit="return confirm('Seguro que deseas eliminar esta venta?');">
                        <button class="btn btn-danger btn-sm">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
